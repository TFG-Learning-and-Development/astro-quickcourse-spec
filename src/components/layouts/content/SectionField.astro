---
export type SectionFieldSurface = "open" | "subtle" | "brand" | "dark" | "image";
export type SectionFieldWidth = "reading" | "wide";

interface Props {
  id?: string;
  surface?: SectionFieldSurface;
  contentWidth?: SectionFieldWidth;
  as?: "section" | "article" | "aside" | "div";
  class?: string;
}

const { id, surface = "open", contentWidth = "wide", as: element = "section", class: className } = Astro.props as Props;
const Tag = element;
---

<Tag id={id} class:list={["qc-section-field", `qc-section-field--${surface}`, className]}>
  <slot name="media" />
  <div class:list={["qc-section-field__inner", `qc-section-field__inner--${contentWidth}`]}>
    <slot />
  </div>
</Tag>
