---
import type { HeroAction } from "./hero-types";
import type { HeadingLevel } from "../layout-types";

interface Props {
  previewId: string;
  headingId: string;
  eyebrow?: string;
  title: string;
  description?: string;
  imageSrc: string;
  imageAlt?: string;
  overlayStyle?: "dark" | "light" | "brand";
  overlayColor?: string;
  textTreatment?: "light" | "dark";
  titleEmphasis?: "standard" | "display";
  bleed?: "container" | "viewport";
  headingLevel?: HeadingLevel;
  action?: Pick<HeroAction, "href" | "label">;
}

const {
  previewId,
  headingId,
  eyebrow,
  title,
  description,
  imageSrc,
  imageAlt = "",
  overlayStyle = "dark",
  overlayColor,
  textTreatment = overlayStyle === "light" ? "dark" : "light",
  titleEmphasis = "standard",
  bleed = "container",
  headingLevel = 4,
  action,
} = Astro.props;

const trimmedEyebrow = eyebrow?.trim();
const trimmedDescription = description?.trim();
const validHexColour = /^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/;
const safeOverlayColour = validHexColour.test(overlayColor ?? "") ? overlayColor : "#1d4ed8";
const HeadingTag = `h${headingLevel}` as const;
---

<section
  class:list={["showcase-hero", "showcase-hero--overlay", bleed === "viewport" && "showcase-hero--bleed-viewport"]}
  data-hero-preview={previewId}
  data-overlay-style={overlayStyle}
  data-text-treatment={textTreatment}
  data-title-emphasis={titleEmphasis}
  style={overlayStyle === "brand" ? `--showcase-hero-overlay-colour: ${safeOverlayColour};` : undefined}
  aria-labelledby={headingId}
>
  <img class="showcase-hero__image" src={imageSrc} alt={imageAlt} />
  <div class="showcase-hero__overlay" aria-hidden="true"></div>
  <div class="showcase-hero__content">
    <p class="showcase-hero__eyebrow" data-hero-part="eyebrow" hidden={!trimmedEyebrow}>{trimmedEyebrow}</p>
    <HeadingTag id={headingId} class="showcase-hero__title" data-hero-part="title">{title}</HeadingTag>
    <p class="showcase-hero__summary" data-hero-part="description" hidden={!trimmedDescription}>{trimmedDescription}</p>
    {action && (
      <div class="showcase-hero__actions" data-hero-actions>
        <a class="showcase-hero__action" href={action.href}>{action.label}</a>
      </div>
    )}
  </div>
</section>
